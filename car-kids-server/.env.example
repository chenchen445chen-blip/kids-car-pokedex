APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=sqlite:///./data/car_kids.db
STORAGE_ROOT=./storage

MAX_UPLOAD_SIZE_MB=10
IMAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

RECOGNITION_PROVIDER=configurable_adapter
RECOGNITION_API_KEY=replace_me
RECOGNITION_API_BASE_URL=https://api.example.com/v1/vehicle-recognize
RECOGNITION_TIMEOUT_SECONDS=20
RECOGNITION_MAX_CONCURRENCY=2

HIGH_CONFIDENCE_THRESHOLD=0.80
CANDIDATE_CONFIDENCE_THRESHOLD=0.50

API_ACCESS_TOKEN=dev_app_access_token_change_in_prod
ADMIN_ACCESS_TOKEN=dev_admin_secret_token_change_in_prod

