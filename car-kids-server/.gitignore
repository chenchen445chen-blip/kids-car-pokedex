# Local SQLite database & runtime WAL/SHM files (auto-seeded on startup)
data/*.db
data/*.db-shm
data/*.db-wal
data/backups/

# Local image storage (excludes third-party crawled photos, brand logos & cache)
storage/

# macOS & IDE files
.DS_Store
*.log
.idea/
.vscode/

