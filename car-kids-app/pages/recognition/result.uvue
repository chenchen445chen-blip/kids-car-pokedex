  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background-color: #f8fafc;
  border-width: 4rpx;
  border-style: solid;
  border-color: #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  overflow: hidden;
}

