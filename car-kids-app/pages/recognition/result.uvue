  font-size: 46rpx;
  font-weight: 700;
  color: #0f172a;
}

.series-sub-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #334155;
  margin-top: 4rpx;
}

.category-pill {
  margin-top: 24rpx;
  background-color: #dbeafe;
  padding: 12rpx 36rpx;
  border-radius: 32rpx;
}

.category-pill-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #1d4ed8;
}

.candidate-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 24rpx;
}

.candidate-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
  border-bottom-width: 2rpx;
  border-bottom-style: solid;
  border-bottom-color: #f1f5f9;
}

.candidate-thumb {
  width: 140rpx;
  height: 100rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
}

.candidate-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
