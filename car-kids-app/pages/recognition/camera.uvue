  font-size: 26rpx;
  color: #cbd5e1;
  text-align: center;
}

.scene-selector {
  margin-top: 24rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
}

.scene-chip {
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  background-color: rgba(255, 255, 255, 0.85);
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.scene-chip-active {
  background-color: #2563eb;
}

.scene-chip-text {
  font-size: 24rpx;
  color: #334155;
  font-weight: 700;
}

.scene-chip-text-active {
  color: #ffffff;
}

.capture-actions {
  padding: 48rpx 64rpx 28rpx 64rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.circle-btn {
  width: 152rpx;
  height: 152rpx;
  border-radius: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-width: 6rpx;
  border-style: solid;
  border-color: #ffffff;
}

.circle-blue {
  background-image: linear-gradient(to bottom, #3b9eff, #1d7dfa);
}

.circle-green {
  background-image: linear-gradient(to bottom, #4ade80, #22c55e);
}

.circle-icon {
  font-size: 64rpx;
}

.circle-label {
