  border-radius: 44rpx;
  background-color: #1e293b;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
  border-width: 6rpx;
  border-style: solid;
  border-color: #ffffff;
}

