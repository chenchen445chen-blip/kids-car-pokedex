  margin-top: 24rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.angle-thumb-wrap {
  width: 31%;
  height: 136rpx;
  border-radius: 18rpx;
  overflow: hidden;
  border-width: 4rpx;
  border-style: solid;
  border-color: transparent;
}

.angle-thumb-active {
  border-color: #2563eb;
}

.angle-thumb-img {
  width: 100%;
  height: 100%;
}

.series-intro-box {
  margin-top: 28rpx;
  background-color: #f8fafc;
  border-radius: 22rpx;
  padding: 24rpx;
}

.series-intro-text {
  font-size: 30rpx;
  line-height: 46rpx;
  color: #1e293b;
  font-weight: 700;
}

.vehicle-sub-section {
  margin-top: 32rpx;
  border-top-width: 2rpx;
  border-top-style: solid;
  border-top-color: #e2e8f0;
  padding-top: 24rpx;
}

.sub-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #334155;
  margin-bottom: 16rpx;
}

.veh-item-card {
  background-color: #f0f7ff;
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.veh-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
}

.year-mini-tag {
  background-color: #3b82f6;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  margin-right: 12rpx;
}

.year-mini-text {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 700;
}

.veh-name-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  margin-right: 12rpx;
}

.veh-trim-text {
  font-size: 26rpx;
  color: #475569;
}

.veh-arrow {
  font-size: 26rpx;
  font-weight: 700;
  color: #1d4ed8;
}
</style>
