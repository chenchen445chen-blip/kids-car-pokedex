<template>
  <view class="app-screen">
    <!-- 顶部状态栏安全区 + 导航栏（还原设计稿下排第2张：奔驰品牌详情页） -->
    <view class="top-header">
      <view class="status-bar-space"></view>
      <view class="nav-bar">
        <view class="nav-back-btn" @click="goBack">
          <text class="nav-icon-text">‹</text>
        </view>
        <text class="nav-title">{{ brandNameZh }}</text>
        <view class="nav-placeholder"></view>
      </view>
    </view>

    <scroll-view class="page-scroll" scroll-y="true">
      <!-- 品牌车标 + 中文名 + 标语 + 车系列表 -->
      <view class="card-box brand-main-card">
        <view class="emblem-circle">
          <image
            v-if="logoUrl != ''"
            :src="logoUrl"
            mode="aspectFit"
            class="emblem-img"
          />
          <text v-else class="emblem-fallback">✦</text>
        </view>

        <text class="brand-big-title">{{ brandNameZh }}</text>
        <text class="brand-slogan">{{ sloganChild }}</text>
        <text v-if="introChild != ''" class="brand-child-intro">
          {{ introChild }}
        </text>

        <!-- 产品线分组（如比亚迪 王朝系列 / 海洋系列，BRAND-009） -->
        <view v-if="productLines.length > 0" class="product-line-tabs">
          <view
            class="pl-pill"
            :class="{ 'pl-pill-active': selectedLineId == 0 }"
            @click="selectProductLine(0)"
          >
            <text class="pl-pill-text" :class="{ 'pl-pill-text-active': selectedLineId == 0 }">
              全部车系
            </text>
          </view>
          <view
            v-for="(pl, pIdx) in productLines"
            :key="pIdx"
            class="pl-pill"
            :class="{ 'pl-pill-active': selectedLineId == (pl.getNumber('id') ?? 0) }"
            @click="selectProductLine(pl.getNumber('id') ?? 0)"
          >
            <text
              class="pl-pill-text"
              :class="{ 'pl-pill-text-active': selectedLineId == (pl.getNumber('id') ?? 0) }"
            >
              {{ pl.getString('name_zh') ?? '' }}
            </text>
          </view>
        </view>

        <view class="series-section-header">
          <text class="series-section-title">车系列表</text>
        </view>

        <!-- 车系列表（如：C级、E级、S级） -->
        <view class="series-rows">
          <view
            v-for="(series, sIdx) in filteredSeriesList"
            :key="sIdx"
            class="series-row-item"
            @click="openSeriesDetail(series.getNumber('id') ?? 0)"
          >
            <image
              :src="getImgUrl(series.getString('cover_image_url'))"
              mode="aspectFill"
              :lazy-load="true"
              class="series-thumb"
            />
            <view class="series-row-info">
              <text class="series-row-name">{{ series.getString('name_zh') ?? '' }}</text>
              <text class="series-row-sub">{{ series.getString('body_type_label') ?? '' }}</text>
            </view>
            <text class="series-row-arrow">›</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref } from 'vue';
import { fetchBrandDetail } from '../../api/catalog.uts';
import { resolveImageUrl } from '../../utils/request.uts';

const selectedLineId = ref<number>(0);
const brandNameZh = ref<string>('奔驰');
const logoUrl = ref<string>('');
const sloganChild = ref<string>('豪华 · 品质 · 未来');
const introChild = ref<string>('');
const productLines = ref<Array<UTSJSONObject>>([]);
const seriesList = ref<Array<UTSJSONObject>>([]);

const filteredSeriesList = computed((): Array<UTSJSONObject> => {
  if (selectedLineId.value == 0) {
    return seriesList.value;
  }
  const result: Array<UTSJSONObject> = [];
  for (let i = 0; i < seriesList.value.length; i++) {
    const item = seriesList.value[i];
    if ((item.getNumber('parent_series_id') ?? 0) == selectedLineId.value) {
      result.push(item);
    }
  }
  return result;
});

onLoad((query: OnLoadOptions) => {
  const id = parseInt(query['id'] ?? '0');
  if (id <= 0) return;
  fetchBrandDetail(id).then((detail: UTSJSONObject) => {
    brandNameZh.value = detail.getString('name_zh') ?? '品牌详情';
    logoUrl.value = resolveImageUrl(detail.getString('logo_url'));
    sloganChild.value = detail.getString('slogan_child') ?? '豪华 · 品质 · 未来';
    introChild.value = detail.getString('introduction_child') ?? '';
    productLines.value = detail.getArray<UTSJSONObject>('product_lines') ?? ([] as Array<UTSJSONObject>);
    seriesList.value = detail.getArray<UTSJSONObject>('series_list') ?? ([] as Array<UTSJSONObject>);
  });
});

function getImgUrl(url: string | null): string {
  return resolveImageUrl(url);
}

function selectProductLine(lineId: number) {
  selectedLineId.value = lineId;
}

function openSeriesDetail(seriesId: number) {
  if (seriesId <= 0) return;
  uni.navigateTo({ url: `/pages/series/detail?id=${seriesId}` });
}

function goBack() {
  uni.navigateBack({ delta: 1 });
}

onShareAppMessage(() => {
  return {
    title: `儿童汽车认知 - ${brandNameZh.value}品牌图鉴`,
    path: '/pages/catalog/index',
  };
});

onShareTimeline(() => {
  return {
    title: `儿童汽车认知 - ${brandNameZh.value}品牌图鉴`,
  };
});
</script>

<style scoped>
.brand-main-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
}

.emblem-circle {
  width: 176rpx;
  height: 176rpx;
  border-radius: 88rpx;
  background-color: #f8fafc;
  border-width: 6rpx;
  border-style: solid;
  border-color: #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.emblem-img {
  width: 136rpx;
  height: 136rpx;
}

.emblem-fallback {
  font-size: 88rpx;
  color: #334155;
}

.brand-big-title {
  margin-top: 24rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #0f172a;
}

.brand-slogan {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #64748b;
}

.brand-child-intro {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #475569;
  text-align: center;
  line-height: 42rpx;
}

.product-line-tabs {
  margin-top: 28rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.pl-pill {
  padding: 10rpx 26rpx;
  border-radius: 26rpx;
  background-color: #f1f5f9;
  margin-right: 16rpx;
  margin-bottom: 12rpx;
}

.pl-pill-active {
  background-color: #2563eb;
}

.pl-pill-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
}

.pl-pill-text-active {
  color: #ffffff;
}

.series-section-header {
  width: 100%;
  margin-top: 36rpx;
  padding-bottom: 16rpx;
  border-bottom-width: 2rpx;
  border-bottom-style: solid;
  border-bottom-color: #e2e8f0;
}

.series-section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.series-rows {
  width: 100%;
  display: flex;
  flex-direction: column;
}

.series-row-item {
  padding: 24rpx 0;
  border-bottom-width: 2rpx;
  border-bottom-style: solid;
  border-bottom-color: #f1f5f9;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.series-thumb {
  width: 168rpx;
  height: 108rpx;
  border-radius: 18rpx;
  background-color: #e2e8f0;
  margin-right: 28rpx;
}

.series-row-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.series-row-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}

.series-row-sub {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #64748b;
}

.series-row-arrow {
  font-size: 44rpx;
  font-weight: 700;
  color: #64748b;
}
</style>
